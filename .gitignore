__pycache__/
*.pyc
.env
venv/
node_modules/
# 開頭加 / 只鎖定專案根目錄下的 data/、models/，避免連
# frontend/src/data/ 這種同名但完全無關的資料夾也被一起忽略
# （2026-08-20 加入 frontend/ 後才發現這個坑，data/ 沒加 / 之前
# 曾經連前端的 src/data/ 都被忽略掉，前端那四個 mock 資料檔案
# 差點永遠進不了 git）
/data/
track1_synthetic/weights/
*.mp4
*.pth
*.onnx

# 證件角點偵測（YOLO-pose）訓練資料跟權重——標註圖片/權重檔是大型
# 二進位檔，不進 git，同 track1_synthetic/weights/ 的做法；.gitkeep
# 讓空資料夾結構本身還是進 git，見 id_card_detector/README.md
/id_card_detector/dataset/images/*/*
!/id_card_detector/dataset/images/*/.gitkeep
/id_card_detector/dataset/labels/*/*
!/id_card_detector/dataset/labels/*/.gitkeep
/id_card_detector/weights/*
!/id_card_detector/weights/.gitkeep
/id_card_detector/test_predictions/
/id_card_detector/id_card_dataset.zip

# 第三方模型檔（MediaPipe .task、InsightFace buffalo_l 等），用雲端硬碟共享
/models/
*.task

# 開發環境雜項
.pytest_cache/
.ipynb_checkpoints/
frontend/.vite/

# 簡報素材，本機用，不進 git
/mascot_assets/
.vscode/
.idea/

# 內部文件，不公開
# 用萬用字元，改檔名時才不會不小心漏掉而被推上去
PLAN*.md
PHASE*_NOTES.md

# 跨隊釐清／規劃往返文件（GF_ 開頭），屬兩邊 AI 討論過程的產物，
# 不是團隊共用的正式規格，不進 git
GF_*.md

# 後台帳號初始化腳本，§8.1 明文規定不進 git（本身不含密碼，但屬於
# 「僅本機執行一次」的一次性工具，不是給團隊共用的程式碼）
scripts/init_admin.py

# 01-06（BRD/PRD/BDD/SRS/SAD/SDS）與 CONVENTIONS.md 已改為公開進 git
# （2026-08-26 起）。07 前端 API 整合規格書、08 使用者旅程文件等其餘
# 內部文件維持不公開，用萬用字元避免之後新增同編號的漏擋
0[7-9]_*.md

# requirements.txt 才是團隊共用的依賴清單，這兩個是 B 本機額外的
# 版本快照，不是給團隊共用的
requirements_B.txt
requirements_locked.txt
