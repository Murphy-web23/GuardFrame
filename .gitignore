__pycache__/
*.pyc
.env
venv/
node_modules/
# 開頭加 / 只鎖定專案根目錄下的 data/、models/，避免連
# frontend/src/data/ 這種同名但完全無關的資料夾也被一起忽略
# （2026-08-20 加入 frontend/ 後才發現這個坑，data/ 沒加 / 之前
# 曾經連前端的 src/data/ 都被忽略掉，前端那四個 mock 資料檔案
# 差點永遠進不了 git）
/data/
track1_synthetic/weights/
*.mp4
*.pth
*.onnx

# 第三方模型檔（MediaPipe .task、InsightFace buffalo_l 等），用雲端硬碟共享
/models/
*.task

# 開發環境雜項
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/

# 內部文件，不公開
# 用萬用字元，改檔名時才不會不小心漏掉而被推上去
CONVENTIONS*.md
PLAN*.md
PHASE*_NOTES.md

# 後台帳號初始化腳本，§8.1 明文規定不進 git（本身不含密碼，但屬於
# 「僅本機執行一次」的一次性工具，不是給團隊共用的程式碼）
scripts/init_admin.py

# BRD/PRD/BDD/SRS/SAD/SDS 系列文件與前端 API 整合規格書，跟
# CONVENTIONS/PLAN/PHASE_NOTES 一樣是團隊內部文件，不進 git
0[1-7]_*.md

# requirements.txt 才是團隊共用的依賴清單，這兩個是 B 本機額外的
# 版本快照，不是給團隊共用的
requirements_B.txt
requirements_locked.txt
