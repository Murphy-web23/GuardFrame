# 複製成 .env 後填入實際值。.env 不進 git。

# PostgreSQL（本機用 Docker 容器 guardframe-pg，見下方指令）
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/guardframe

# 起 / 停容器：
#   docker start guardframe-pg
#   docker stop guardframe-pg
# 首次建立（已建過一次，供重建參考）：
#   docker run --name guardframe-pg -e POSTGRES_PASSWORD=your_password \
#     -e POSTGRES_DB=guardframe -p 5433:5432 \
#     -v guardframe-pg-data:/var/lib/postgresql/data -d postgres:17
#
# 用 5433 而不是預設 5432，是因為本機可能已裝有原生 PostgreSQL 服務占用 5432，
# 這樣兩者不會衝突。

# 後台登入密碼（§5.5 的 POST /api/admin/login）
ADMIN_PASSWORD=change_me

# JWT 簽章金鑰
SECRET_KEY=change_me
